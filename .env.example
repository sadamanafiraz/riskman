# Turso: connection URL dan token database milik Anda
TURSO_DATABASE_URL=libsql://NAMA-DATABASE.turso.io
TURSO_AUTH_TOKEN=GANTI_DENGAN_TOKEN_TURSO
# Clerk: API keys milik aplikasi Anda
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_GANTI_DENGAN_KEY_ANDA
CLERK_SECRET_KEY=sk_test_GANTI_DENGAN_KEY_ANDA
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Email utama terverifikasi yang boleh membuat kelas (pisahkan dengan koma)
TEACHER_EMAILS=pengajar@example.com
